# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore editor directories and files
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.user
*.ncb
*.sdf
*.opensdf

# Ignore build output
bin/
obj/
dist/
build/
out/

# Ignore dependency directories
node_modules/
venv/
.env/
.env
.env.*

# Ignore Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Ignore logs and temporary files
*.log
*.tmp
*.temp

# Ignore package lock files
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Keep uploads directory, ignore its contents
app/templates/uploads/*
!app/templates/uploads/.gitkeep

generated/proposal_visuals/*